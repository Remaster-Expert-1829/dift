{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON",
        "SPOINK_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Developer debug build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-gcc",
      "inherits": "base",
      "displayName": "Linux GCC CI build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/usr/bin/gcc-13",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-13"
      }
    },
    {
      "name": "ci-clang",
      "inherits": "base",
      "displayName": "Linux Clang CI build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/usr/bin/clang-18",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18"
      }
    },
    {
      "name": "sanitize",
      "inherits": "ci-clang",
      "displayName": "Linux AddressSanitizer and UndefinedBehaviorSanitizer build",
      "cacheVariables": {
        "SPOINK_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "ci-clang",
      "displayName": "Linux clang-tidy build",
      "cacheVariables": {
        "SPOINK_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release-representative build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci-gcc", "configurePreset": "ci-gcc" },
    { "name": "ci-clang", "configurePreset": "ci-clang" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "ci-gcc", "configurePreset": "ci-gcc", "output": { "outputOnFailure": true } },
    { "name": "ci-clang", "configurePreset": "ci-clang", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
